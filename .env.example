# Expo public client configuration. Copy this file to .env for local development.
# Use the Supabase project URL and its publishable/anon client key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Never place a Supabase service-role key, account-deletion admin secret,
# SMTP credential, or any other server secret in an EXPO_PUBLIC_* variable.
# EXPO_PUBLIC_* values are embedded in the mobile application bundle.
